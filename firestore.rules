// Firestore Security Rules
//
// TRUST MODEL (DEC-033 to DEC-040)
//
//   anonymous customer   reads reference data (stylists, services, hours) and
//                        slotBlocks (the PII-free availability projection) and
//                        NOTHING else. Customers never write directly: a booking
//                        request, a waitlist entry and every notification are
//                        created by Cloud Functions (functions/src/), which
//                        validate, price, conflict-check and rate-limit them.
//   owner                a signed-in account whose ID token carries the custom
//                        claim role == 'owner'. Everything.
//   stylist              role == 'stylist' with a stylistId claim. Reads and
//                        updates only their own stylist's bookings (and their own
//                        notifications); never deletes; no settings, prices or
//                        client lists.
//   unprovisioned        signed in but no role claim. No access at all - the old
//                        rule "any signed-in account is staff" is gone.
//
// Roles live in CUSTOM CLAIMS on the ID token (request.auth.token), set only by
// the Admin SDK (functions/src/roles.ts, functions/scripts/provision-roles.ts).
// A claim costs zero document reads per rule evaluation; the earlier
// get(users/{uid}) approach billed one read for every owner check and made every
// list query pay for it. The users/{uid} document is kept as the readable record
// of the grant (and is what the functions check, so a revoked role stops working
// in functions at once; rules honour the claim until the token refreshes, up to
// an hour - revoking also calls revokeRefreshTokens).
//
// Firestore Rules cannot redact individual fields from an authorized read - a
// rule can only authorize or deny a whole document - so customer PII (bookings,
// customerLookups, waitlist) is never readable by the public, and the public
// calendar reads the PII-free `slotBlocks` projection instead.
//
// Deploy with: firebase deploy --only firestore:rules
// BUT ONLY AFTER the owner has been provisioned and the new app and functions are
// live - see docs/DEPLOYMENT.md for the order and the rollback.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Roles (custom claims; no document reads) ─────────────────────────
    function isOwner() {
      return request.auth != null
        && request.auth.token.get('role', '') == 'owner';
    }

    function isStylist() {
      return request.auth != null
        && request.auth.token.get('role', '') == 'stylist'
        && request.auth.token.get('stylistId', '') is string
        && request.auth.token.get('stylistId', '') != '';
    }

    // Owner or stylist. NOT "any signed-in account".
    function isStaff() {
      return isOwner() || isStylist();
    }

    // The signed-in stylist, for the stylist whose id is `id`.
    function ownStylist(id) {
      return isStylist() && request.auth.token.stylistId == id;
    }

    // Booking lifecycle statuses (src/lib/bookingStatus.ts). Owner writes to
    // bookings and slotBlocks must use one of these so a typo can't strand a
    // booking in a state the app doesn't understand. A document without a status
    // field (hand-edited / pre-migration) is left alone.
    function hasValidStatus(d) {
      return !('status' in d)
        || d.status in ['pending', 'confirmed', 'arrived', 'in_service',
                        'completed', 'no_show', 'cancelled'];
    }

    // The statuses a stylist may move their own booking through: the day-of
    // lifecycle only. Approving, declining, cancelling and restoring are the
    // owner's, and run through the booking commands (they re-check the slot).
    function isStylistStatus(s) {
      return s in ['arrived', 'in_service', 'completed', 'no_show'];
    }

    // Phase fields (DEC-026). A booking carries `phases` and `segments` (lists of
    // {type, minutes} / {type, start, end}); its public slotBlocks projection
    // carries `busy` (the hands-on blocks, {start, end} in minutes from midnight)
    // and `returnAt` (the minute the stylist is due back, or null). They must be
    // lists of a sane size - nothing here can carry customer data.
    function hasValidPhases(d) {
      return (!('phases' in d) || (d.phases is list && d.phases.size() <= 8))
        && (!('segments' in d) || (d.segments is list && d.segments.size() <= 8))
        && (!('busy' in d) || (d.busy is list && d.busy.size() <= 8))
        && (!('returnAt' in d) || d.returnAt == null || d.returnAt is number);
    }

    // ── bookings ────────────────────────────────────────────────────────
    // Full booking records, including customer PII (name, phone, notes).
    // Customers never read or write them. Online requests are created by the
    // createBookingRequest function (Admin SDK, which bypasses these rules);
    // approve / decline / cancel / restore / assign go through their own
    // functions, which re-check the slot under the stylist-day lock. The owner's
    // direct writes remain for walk-ins, breaks, training, phase edits and
    // reschedules (src/lib/adminBookingWrites.ts, same lock).
    match /bookings/{bookingId} {
      allow get: if isOwner() || ownStylist(resource.data.stylistId);
      allow list: if isOwner() || ownStylist(resource.data.stylistId);

      allow create: if isOwner() && hasValidStatus(request.resource.data)
        && hasValidPhases(request.resource.data);

      allow update: if (isOwner() && hasValidStatus(request.resource.data)
                        && hasValidPhases(request.resource.data))
        || stylistMayUpdateBooking();

      allow delete: if isOwner();

      // A stylist may add a note, flag a booking, or move it through the day's
      // lifecycle - on their own bookings, and nothing else: not the stylist,
      // date, time, price or phases, and not out of pending / into cancelled.
      function stylistMayUpdateBooking() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return ownStylist(resource.data.stylistId)
          && changed.hasOnly(['status', 'arrivedAt', 'history', 'flagged',
                              'flagReason', 'notes', 'restoreStatus'])
          && (!changed.hasAny(['status'])
              || (resource.data.status in ['confirmed', 'arrived', 'in_service']
                  && isStylistStatus(request.resource.data.status)));
      }
    }

    // ── slotBlocks ──────────────────────────────────────────────────────
    // PII-free projection of `bookings` (stylistId/date/time/activeTime/
    // totalTime/restTime/status/busy/returnAt only) used solely to compute public
    // availability. Safe to read publicly - it never carries a customer name,
    // phone number, or note. Nothing anonymous can write it: the booking
    // functions write it together with the booking in one transaction.
    match /slotBlocks/{bookingId} {
      allow read, list: if true;

      allow create: if isOwner() && hasValidStatus(request.resource.data)
        && hasValidPhases(request.resource.data);

      allow update: if (isOwner() && hasValidStatus(request.resource.data)
                        && hasValidPhases(request.resource.data))
        || (ownStylist(resource.data.stylistId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && isStylistStatus(request.resource.data.status)
            && resource.data.status in ['confirmed', 'arrived', 'in_service']);

      allow delete: if isOwner();
    }

    // ── stylistDayLocks ─────────────────────────────────────────────────
    // One tiny document per stylist per day ({date}_{stylistId}). Every write that
    // claims a slot (walk-in, break, restore, reschedule, and the booking
    // functions) reads and bumps it inside the same transaction as its conflict
    // check, so two writers cannot both take the same slot - see
    // src/lib/adminBookingWrites.ts and functions/src/bookingCommands.ts. Holds no
    // customer data. Owner only; the functions use the Admin SDK.
    match /stylistDayLocks/{lockId} {
      allow read: if isOwner();
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly(['version', 'updatedAt'])
        && request.resource.data.version is number
        && request.resource.data.updatedAt is string;
      allow delete: if false;
    }

    // ── Reference data used by the public booking flow ─────────────────
    // Publicly readable so the calendar can show stylists/services/hours.
    // Writes are OWNER-only: prices, services, stylist management (including the
    // display `order`), salon settings and opening hours.
    match /stylists/{stylistId} {
      allow read: if true;
      allow create, update: if isOwner()
        && (!('order' in request.resource.data) || request.resource.data.order is number);
      allow delete: if isOwner();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /salonSettings/{settingsId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // ── privateSettings ─────────────────────────────────────────────────
    // Owner-only configuration that must not be world-readable the way
    // salonSettings is - currently the owner's notification email address
    // (privateSettings/notifications). Cloud Functions read it with the
    // Admin SDK, which bypasses these rules.
    match /privateSettings/{docId} {
      allow read: if isOwner();
      allow write: if isOwner()
        && request.resource.data.keys().hasOnly(['notifyOwnerByEmail', 'ownerEmail'])
        && request.resource.data.notifyOwnerByEmail is bool
        && request.resource.data.ownerEmail is string
        && request.resource.data.ownerEmail.size() <= 254;
    }

    // ── notifications ───────────────────────────────────────────────────
    // The staff notification bell. Online requests, waitlist entries and expiries
    // are written by the booking functions (Admin SDK); the owner's own admin
    // screens (walk-ins, the processing countdown) may add one too. Customers never
    // can. The owner reads everything; a stylist reads and marks read only the
    // notifications addressed to their own stylistId.
    match /notifications/{notificationId} {
      allow read: if isOwner()
        || (isStylist() && resource.data.recipientId == request.auth.token.stylistId);
      allow update: if isOwner()
        || (isStylist() && resource.data.recipientId == request.auth.token.stylistId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']));
      allow delete: if isOwner();
      allow create: if isOwner();
    }

    // ── waitlist ─────────────────────────────────────────────────────────
    // Entries are created by the joinWaitlist function (validated and rate
    // limited). Only the owner lists, reads, updates or deletes them.
    match /waitlist/{waitlistId} {
      allow read, update, delete: if isOwner();
      allow create: if false;
    }

    // ── customerLookups ─────────────────────────────────────────────────
    // Customer identity + visit history keyed by cleaned phone number, plus the
    // `blocked` flag the Fresha import sets (DEC-039). Even a get-by-document-ID
    // lookup exposes the account holder's name and block status to anyone who
    // merely knows a phone number, so it is owner-only. The booking function
    // reads and merges it with the Admin SDK.
    match /customerLookups/{phone} {
      allow get, list, create, update, delete: if isOwner();
    }

    // ── importBatches ────────────────────────────────────────────────────
    // The owner's client-list import (Manage -> Import clients): one document per
    // run, and under it the phone numbers each committed chunk created (and the
    // ones it marked blocked), which is what a rollback walks. Phone numbers are
    // personal data, so the ledger is owner-only.
    match /importBatches/{batchId} {
      allow read, delete: if isOwner();
      allow create, update: if isOwner()
        && request.resource.data.status in ['running', 'complete', 'failed', 'rolled_back']
        && request.resource.data.source is string;

      match /chunks/{chunkId} {
        allow read, delete: if isOwner();
        allow create, update: if isOwner()
          && request.resource.data.keys().hasOnly(['phones', 'blocked'])
          && request.resource.data.phones is list
          && request.resource.data.phones.size() <= 500
          && (!('blocked' in request.resource.data)
              || (request.resource.data.blocked is list
                  && request.resource.data.blocked.size() <= 500));
      }
    }

    // ── clients, clientCards, notes, audit (DEC-044 to DEC-049) ──────────────
    // clients/{phone}: one document per client, OWNER ONLY - it holds total spend,
    // the blocked reason and the email, and a rule cannot hide a field from an
    // authorised read. The owner writes it from the browser (details, tags, block,
    // the Fresha import) and the functions write it with the Admin SDK (recompute).
    //
    // clientCards/{phone} is the slim copy a STYLIST may read, and only for a client
    // who has a booking with them (stylistIds): name, phone, tags, blocked yes/no. No
    // spend, no email, no reason. Their own bookings with the client are read from
    // `bookings` (the booking rules already limit them to their own).
    //
    // Notes are append-only: created with the author's own uid, never rewritten
    // except to pin or unpin; the owner deletes any, a stylist only their own.
    // The audit trail is owner-only and write-once.
    function cardAllowsMe(clientId) {
      return isStylist()
        && get(/databases/$(database)/documents/clientCards/$(clientId)).data.stylistIds
             .hasAny([request.auth.token.stylistId]);
    }

    function validNote(n) {
      return n.keys().hasOnly(['text', 'authorUid', 'authorName', 'createdAt', 'pinned'])
        && n.text is string && n.text.size() > 0 && n.text.size() <= 2000
        && n.authorUid == request.auth.uid
        && n.authorName is string && n.authorName.size() <= 100
        && n.createdAt is string
        && n.pinned is bool;
    }

    match /clients/{clientId} {
      allow read, write: if isOwner();

      match /notes/{noteId} {
        allow read: if isOwner() || cardAllowsMe(clientId);
        allow create: if (isOwner() || cardAllowsMe(clientId)) && validNote(request.resource.data);
        // pin / unpin only - the text and the author never change
        allow update: if (isOwner() || (isStylist() && resource.data.authorUid == request.auth.uid))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned']);
        allow delete: if isOwner() || (isStylist() && resource.data.authorUid == request.auth.uid);
      }

      match /audit/{entryId} {
        allow read: if isOwner();
        allow create: if isOwner()
          && request.resource.data.keys().hasOnly(['action', 'byUid', 'byName', 'at', 'detail'])
          && request.resource.data.byUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /clientCards/{clientId} {
      allow get, list: if isOwner()
        || (isStylist() && request.auth.token.stylistId in resource.data.stylistIds);
      allow write: if isOwner();
    }

    // The build-the-client-list ledger (owner only, written by the function).
    match /clientBackfills/{batchId} {
      allow read: if isOwner();
      allow write: if false;
      match /chunks/{chunkId} {
        allow read: if isOwner();
        allow write: if false;
      }
    }

    // ── users ────────────────────────────────────────────────────────────
    // The readable record of each role grant ({role, stylistId?, email?}),
    // written ONLY by the Admin SDK (roles.ts). A provisioned user reads their own;
    // the owner reads all (role management). An unprovisioned account has no
    // access, not even to its own (non-existent) document.
    match /users/{userId} {
      allow read: if isOwner() || (isStaff() && request.auth.uid == userId);
      allow write: if false;
    }

    // rateLimits and phoneLimits (functions' abuse counters) have no rule, so
    // they are denied to every client and used only through the Admin SDK.

    // Deny everything else by default.
  }
}
